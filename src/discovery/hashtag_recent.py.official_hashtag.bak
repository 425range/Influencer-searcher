from __future__ import annotations

from collections import defaultdict
from src.models import Candidate


def _dataset_id(run):
    dataset_id = getattr(run, "default_dataset_id", None)
    if not dataset_id and isinstance(run, dict):
        dataset_id = run.get("defaultDatasetId")
    if not dataset_id:
        raise RuntimeError("Could not get Apify dataset id.")
    return dataset_id


def _clean_hashtags(values):
    return list(dict.fromkeys(str(x).strip().lstrip("#") for x in (values or []) if str(x).strip().lstrip("#")))


def _owner(item):
    return str(item.get("ownerUsername") or item.get("owner") or item.get("username") or item.get("authorUsername") or "").strip().lstrip("@")


def _followers(item):
    for key in ("ownerFollowers", "followersCount", "followers", "ownerFollowerCount"):
        value = item.get(key)
        if value is None:
            continue
        try:
            return int(value)
        except (TypeError, ValueError):
            pass
    return None


def _tag(item):
    return str(item.get("sourceHashtag") or item.get("hashtag") or "").strip().lstrip("#")


def _post_key(item):
    return str(item.get("postId") or item.get("id") or item.get("url") or item.get("shortcode") or "")


def _run_actor(client, actor_id, hashtags, limit):
    run = client.actor(actor_id).call(run_input={"hashtags": hashtags, "limit": int(limit), "sortBy": "recent"})
    if run is None:
        raise RuntimeError("Instagram hashtag Actor failed.")
    return list(client.dataset(_dataset_id(run)).iterate_items())


def discover_by_hashtags(client, hashtags, actor_id, initial_posts, max_posts, target_valid_candidates,
                         min_followers, max_followers, expand_search=False, allow_unknown_followers=False):
    hashtags = _clean_hashtags(hashtags)
    if not hashtags:
        return [], {}

    initial_posts = max(1, int(initial_posts))
    max_posts = max(initial_posts, int(max_posts))
    target_valid_candidates = max(1, int(target_valid_candidates))
    current_limit = initial_posts
    seen_posts = set()
    valid_users = {}
    stats = defaultdict(lambda: {"posts": 0, "authors": set(), "qualified": set(), "out": set(), "unknown": set()})
    actor_runs = 0

    while True:
        actor_runs += 1
        print(f"  hashtag run {actor_runs}: tags={len(hashtags)}, limit={current_limit}/tag, sort=recent")
        if actor_runs > 1:
            print("  [cost warning] Actor has no offset; larger-limit reruns can include earlier posts again.")

        for item in _run_actor(client, actor_id, hashtags, current_limit):
            pk = _post_key(item)
            if pk and pk in seen_posts:
                continue
            if pk:
                seen_posts.add(pk)
            username = _owner(item)
            if not username:
                continue
            tag = _tag(item) or "(unknown)"
            followers = _followers(item)
            st = stats[tag]
            st["posts"] += 1
            st["authors"].add(username.lower())

            if followers is None:
                st["unknown"].add(username.lower())
                if not allow_unknown_followers:
                    continue
            elif not (min_followers <= followers <= max_followers):
                st["out"].add(username.lower())
                continue
            else:
                st["qualified"].add(username.lower())

            key = username.lower()
            if key not in valid_users:
                valid_users[key] = Candidate(username=username,
                                             profile_url=f"https://www.instagram.com/{username}/",
                                             source="hashtag",
                                             source_seed=f"#{tag}" if tag != "(unknown)" else "",
                                             discovery_depth=0,
                                             followers=followers)

        if len(valid_users) >= target_valid_candidates:
            print(f"  hashtag early stop: qualified={len(valid_users)} >= target={target_valid_candidates}")
            break
        if not expand_search:
            print(f"  hashtag expansion OFF: qualified={len(valid_users)}, target={target_valid_candidates}")
            break
        if current_limit >= max_posts:
            print(f"  hashtag maximum reached: {current_limit}/tag, qualified={len(valid_users)}")
            break
        current_limit = min(current_limit + initial_posts, max_posts)

    all_authors, all_qualified = set(), set()
    by_tag = {}
    for tag, st in sorted(stats.items()):
        unique_n = len(st["authors"])
        qualified_n = len(st["qualified"])
        y = qualified_n / unique_n if unique_n else 0.0
        all_authors |= st["authors"]
        all_qualified |= st["qualified"]
        by_tag[tag] = {"posts_seen": st["posts"], "unique_authors": unique_n,
                       "follower_qualified": qualified_n, "out_of_scope": len(st["out"]),
                       "unknown_followers": len(st["unknown"]), "yield_rate": round(y, 4)}
        print(f"    #{tag}: posts={st['posts']}, unique_authors={unique_n}, follower_qualified={qualified_n}, yield={y:.1%}")

    overall = len(all_qualified) / len(all_authors) if all_authors else 0.0
    print(f"  hashtag summary: unique_authors={len(all_authors)}, qualified={len(valid_users)}, yield={overall:.1%}")
    return list(valid_users.values()), {"actor_runs": actor_runs, "limit_per_hashtag": current_limit,
                                       "unique_authors": len(all_authors), "follower_qualified": len(valid_users),
                                       "yield_rate": round(overall, 4), "by_hashtag": by_tag}
